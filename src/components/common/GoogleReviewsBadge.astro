---
import { clinic } from '../../data/clinic';
import Icon from './Icon.astro';

interface Props {
  class?: string;
  compact?: boolean;
  emphasis?: boolean;
}

const { class: className = '', compact = false, emphasis = false } = Astro.props;
const value = clinic.rating.value;
const percent = Math.max(0, Math.min(100, (value / 5) * 100));
const valueLabel = value.toFixed(1).replace('.', ',');
const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
  `${clinic.name} ${clinic.address.street}, ${clinic.address.postalCode} ${clinic.address.city}, ${clinic.address.district}`,
)}`;
---

<a
  href={mapsUrl}
  target="_blank"
  rel="noopener noreferrer"
  class:list={['inline-flex items-center gap-2.5 rounded-full border border-brand-900/10 bg-white px-3.5 py-2 no-underline transition-colors hover:border-brand-700/30', className]}
  aria-label={`${valueLabel} sobre 5 estrellas según ${clinic.rating.count} reseñas de ${clinic.rating.source}. Abrir en Google Maps`}
>
  <span class="relative inline-flex" aria-hidden="true">
    <span class="flex text-brand-200">
      <Icon name="star" class="h-4 w-4" />
      <Icon name="star" class="h-4 w-4" />
      <Icon name="star" class="h-4 w-4" />
      <Icon name="star" class="h-4 w-4" />
      <Icon name="star" class="h-4 w-4" />
    </span>
    <span class="absolute inset-0 flex overflow-hidden text-gold-500" style={`width:${percent}%`}>
      <Icon name="star" class="h-4 w-4 shrink-0" />
      <Icon name="star" class="h-4 w-4 shrink-0" />
      <Icon name="star" class="h-4 w-4 shrink-0" />
      <Icon name="star" class="h-4 w-4 shrink-0" />
      <Icon name="star" class="h-4 w-4 shrink-0" />
    </span>
  </span>
  <span class:list={['font-semibold text-ink-900', emphasis ? 'text-xl sm:text-2xl' : 'text-sm']}>
    {valueLabel}
  </span>
  {!compact && (
    <span class:list={['text-ink-500', emphasis ? 'text-sm sm:text-base' : 'text-xs']}>
      {clinic.rating.count} reseñas en {clinic.rating.source}
    </span>
  )}
</a>
