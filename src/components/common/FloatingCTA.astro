---
import { telHref, whatsappHref } from '../../data/clinic';
import Icon from './Icon.astro';
---

<!-- Barra inferior en móvil -->
<div
  class="fixed inset-x-0 bottom-0 z-40 border-t border-brand-900/10 bg-white/95 px-4 pb-[calc(0.6rem+env(safe-area-inset-bottom))] pt-2.5 backdrop-blur sm:hidden"
>
  <div class="flex gap-2.5">
    <a href="/pedir-cita" class="btn-primary flex-1 px-4 py-3">
      <Icon name="calendar" class="h-4 w-4" />
      Pedir cita
    </a>
    {
      whatsappHref ? (
        <a
          href={whatsappHref}
          class="btn-secondary flex-1 px-4 py-3"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Icon name="whatsapp" class="h-4 w-4" />
          WhatsApp
        </a>
      ) : (
        <a href={telHref} class="btn-secondary flex-1 px-4 py-3">
          <Icon name="phone" class="h-4 w-4" />
          Llamar
        </a>
      )
    }
  </div>
</div>

<!-- Acceso rápido en escritorio -->
{
  whatsappHref && (
    <div class="fixed bottom-6 right-6 z-40 hidden sm:flex">
      <a
        href={whatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-2 rounded-full bg-white px-4 py-3 text-sm font-semibold text-brand-800 no-underline shadow-lg ring-1 ring-brand-900/10 transition-transform hover:-translate-y-0.5"
      >
        <Icon name="whatsapp" class="h-5 w-5 text-brand-600" />
        WhatsApp
      </a>
    </div>
  )
}
