# --- Correo (Resend) -------------------------------------------------------
# Clave de API de Resend (https://resend.com). Sin ella no se envían correos.
RESEND_API_KEY=

# Buzón de recepción que recibe cada solicitud de cita o mensaje de contacto.
BOOKING_TO_EMAIL=

# Remitente verificado en Resend. Debe pertenecer a un dominio verificado.
BOOKING_FROM_EMAIL="Clínica Dental Hortaleza <citas@clinicadentalhortaleza.es>"

# --- TinaCMS (opcional, solo para edición en la nube) ----------------------
TINA_CLIENT_ID=
TINA_TOKEN=
