---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Picture from '../../components/common/Picture.astro';
import Icon from '../../components/common/Icon.astro';
import { siteUrl } from '../../data/clinic';
import { formatDate } from '../../lib/format';
import { breadcrumbSchema } from '../../lib/schema-markup';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime(),
);

const extraSchema = [
  breadcrumbSchema(siteUrl, [
    { name: 'Inicio', path: '/' },
    { name: 'Blog', path: '/blog/' },
  ]),
  {
    '@type': 'Blog',
    name: 'Blog de la Clínica Dental Hortaleza',
    url: `${siteUrl}/blog/`,
    inLanguage: 'es-ES',
  },
];
---

<BaseLayout
  title="Blog dental: salud bucodental en Hortaleza"
  description="Artículos sobre implantes, encías, blanqueamiento y salud bucodental escritos por la Clínica Dental Hortaleza (28033 Madrid)."
  extraSchema={extraSchema}
>
  <section class="border-b border-brand-900/10 bg-cream-100/60">
    <div class="container-page py-12 sm:py-14">
      <nav aria-label="Migas de pan" class="text-xs text-ink-500">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="no-underline hover:text-brand-800">Inicio</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-ink-700">Blog</li>
        </ol>
      </nav>

      <h1 class="mt-5 font-display text-4xl leading-tight text-ink-900 sm:text-5xl">
        Salud bucodental, explicada
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-700">
        Dudas frecuentes que resolvemos en consulta, por escrito y sin tecnicismos innecesarios.
      </p>
    </div>
  </section>

  <section class="py-12 sm:py-14">
    <div class="container-page">
      {
        posts.length === 0 ? (
          <p class="text-ink-500">Estamos preparando los primeros artículos.</p>
        ) : (
          <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => (
              <article class="flex h-full flex-col overflow-hidden rounded-3xl border border-brand-900/10 bg-white">
                {post.data.image && (
                  <a href={`/blog/${post.id}`} class="block">
                    <Picture
                      src={post.data.image}
                      alt={post.data.imageAlt ?? ''}
                      class="h-48 w-full object-cover"
                      sizes="(min-width: 1024px) 30vw, (min-width: 768px) 45vw, 100vw"
                    />
                  </a>
                )}
                <div class="flex flex-1 flex-col p-6">
                  <p class="text-xs text-ink-500">
                    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                    {' · '}
                    {post.data.readingMinutes} min de lectura
                  </p>
                  <h2 class="mt-2 font-display text-xl leading-snug text-ink-900">
                    <a href={`/blog/${post.id}`} class="no-underline hover:text-brand-700">
                      {post.data.title}
                    </a>
                  </h2>
                  <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-500">
                    {post.data.description}
                  </p>
                  <a
                    href={`/blog/${post.id}`}
                    class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-brand-700 no-underline hover:underline"
                  >
                    Leer artículo
                    <Icon name="arrow-right" class="h-4 w-4" />
                  </a>
                </div>
              </article>
            ))}
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>
