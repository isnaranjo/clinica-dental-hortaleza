---
import Icon from '../common/Icon.astro';
---

<form id="contact-form" novalidate class="rounded-[2rem] border border-brand-900/10 bg-white p-6 sm:p-8">
  <div class="grid gap-3 sm:grid-cols-2">
    <div>
      <label for="contact-name" class="block text-xs font-medium text-ink-500">Nombre</label>
      <input
        type="text"
        id="contact-name"
        name="name"
        class="field mt-1.5"
        autocomplete="name"
        required
        minlength="2"
        maxlength="80"
      />
    </div>
    <div>
      <label for="contact-phone" class="block text-xs font-medium text-ink-500">Teléfono</label>
      <input
        type="tel"
        id="contact-phone"
        name="phone"
        class="field mt-1.5"
        autocomplete="tel"
        inputmode="tel"
        required
        maxlength="20"
      />
    </div>
    <div class="sm:col-span-2">
      <label for="contact-email" class="block text-xs font-medium text-ink-500">Correo electrónico</label>
      <input
        type="email"
        id="contact-email"
        name="email"
        class="field mt-1.5"
        autocomplete="email"
        required
        maxlength="120"
      />
    </div>
    <div class="sm:col-span-2">
      <label for="contact-message" class="block text-xs font-medium text-ink-500">Mensaje</label>
      <textarea
        id="contact-message"
        name="message"
        rows="5"
        class="field mt-1.5"
        required
        minlength="10"
        maxlength="1500"
        placeholder="Cuéntanos qué necesitas y te responderemos lo antes posible."
      ></textarea>
    </div>
  </div>

  <label class="mt-4 flex items-start gap-3 text-xs leading-relaxed text-ink-500">
    <input type="checkbox" name="consent" value="si" class="mt-0.5 h-4 w-4 shrink-0 accent-[var(--color-brand-700)]" required />
    <span>
      He leído y acepto la
      <a href="/legal/privacidad" class="text-brand-700 underline underline-offset-2">política de privacidad</a>.
      No incluyas datos de salud en este formulario; para eso está la cita.
    </span>
  </label>

  <div class="sr-only" aria-hidden="true">
    <label for="contact-website">No rellenar</label>
    <input type="text" id="contact-website" name="website" tabindex="-1" autocomplete="off" />
  </div>

  <button type="submit" id="contact-submit" class="btn-primary mt-5 w-full">
    <Icon name="mail" class="h-4 w-4" />
    <span id="contact-submit-label">Enviar mensaje</span>
  </button>

  <p id="contact-message" role="alert" class="mt-3 text-sm text-red-700"></p>
  <p id="contact-success" role="status" class="mt-3 hidden text-sm text-brand-800">
    Mensaje enviado. Te responderemos en horario de apertura.
  </p>
</form>

<script>
  const form = document.querySelector<HTMLFormElement>('#contact-form')!;
  const submit = document.querySelector<HTMLButtonElement>('#contact-submit')!;
  const label = document.querySelector<HTMLSpanElement>('#contact-submit-label')!;
  const errorEl = document.querySelector<HTMLParagraphElement>('#contact-message')!;
  const successEl = document.querySelector<HTMLParagraphElement>('#contact-success')!;

  if (form && submit && label && errorEl && successEl) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      errorEl.textContent = '';
      successEl.classList.add('hidden');

      const payload = Object.fromEntries(new FormData(form).entries());
      if (!payload.consent) {
        errorEl.textContent = 'Necesitamos tu consentimiento para responderte.';
        return;
      }

      submit.disabled = true;
      label.textContent = 'Enviando…';

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'content-type': 'application/json', accept: 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = (await response.json()) as { ok?: boolean; error?: string };

        if (!response.ok || !result.ok) {
          throw new Error(result.error ?? 'No se pudo enviar el mensaje.');
        }

        form.reset();
        successEl.classList.remove('hidden');
      } catch (error) {
        errorEl.textContent =
          error instanceof Error
            ? error.message
            : 'No se pudo enviar el mensaje. Llámanos al 913 82 08 64.';
      } finally {
        submit.disabled = false;
        label.textContent = 'Enviar mensaje';
      }
    });
  }
</script>
