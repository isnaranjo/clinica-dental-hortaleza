---
import Icon from '../common/Icon.astro';

interface Props {
  slug: string;
  title: string;
  summary: string;
  duration?: number;
}

const { slug, title, summary, duration } = Astro.props;

const ICONS: Record<string, string> = {
  implantes: 'implant',
  'estetica-dental': 'sparkle',
  endodoncias: 'tooth',
  protesis: 'crown',
  ortodoncia: 'braces',
  'diagnostico-digital': 'scanner',
};

const icon = ICONS[slug] ?? 'tooth';
---

<a
  href={`/tratamientos/${slug}`}
  class="group flex h-full flex-col justify-between rounded-3xl border border-brand-900/10 bg-white p-6 no-underline transition duration-200 hover:-translate-y-0.5 hover:border-brand-700/30 hover:shadow-[0_18px_40px_-24px_rgba(8,60,64,0.45)]"
>
  <div>
    <span
      class="flex h-11 w-11 items-center justify-center rounded-2xl bg-brand-50 text-brand-700 transition-colors group-hover:bg-brand-700 group-hover:text-white"
    >
      <Icon name={icon} class="h-6 w-6" />
    </span>
    <h3 class="mt-4 font-display text-xl text-ink-900">{title}</h3>
    <p class="mt-2 text-sm leading-relaxed text-ink-500">{summary}</p>
  </div>

  <div class="mt-6 flex items-center justify-between gap-3">
    <span class="inline-flex items-center gap-2 text-sm font-semibold text-brand-700">
      Ver tratamiento
      <Icon name="arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
    </span>
    {
      duration && (
        <span class="inline-flex items-center gap-1.5 rounded-full bg-cream-100 px-2.5 py-1 text-xs font-medium text-ink-700">
          <Icon name="clock" class="h-3.5 w-3.5" />
          {duration} min
        </span>
      )
    }
  </div>
</a>
