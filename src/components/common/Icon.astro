interface Props {
  name: string;
  class?: string;
  strokeWidth?: number;
}

const { name, class: className = 'h-5 w-5', strokeWidth = 1.6 } = Astro.props;
const icon = ICONS[name as IconName] ?? ICONS.tooth;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  class={className}
  fill={icon.filled ? 'currentColor' : 'none'}
  stroke={icon.filled ? 'none' : 'currentColor'}
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <Fragment set:html={icon.body} />
</svg>
