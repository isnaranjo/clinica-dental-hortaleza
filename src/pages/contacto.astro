---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/contact/ContactForm.astro';
import LocationMap from '../components/common/LocationMap.astro';
import GoogleReviewsBadge from '../components/common/GoogleReviewsBadge.astro';
import Icon from '../components/common/Icon.astro';
import { addressLine, clinic, siteUrl, telHref, whatsappHref } from '../data/clinic';
import { openingHoursLines } from '../lib/format';
import { breadcrumbSchema } from '../lib/schema-markup';

const hours = openingHoursLines();

const extraSchema = [
  breadcrumbSchema(siteUrl, [
    { name: 'Inicio', path: '/' },
    { name: 'Contacto', path: '/contacto/' },
  ]),
  {
    '@type': 'ContactPage',
    name: `Contacto — ${clinic.name}`,
    url: `${siteUrl}/contacto/`,
    about: { '@id': `${siteUrl}/#clinica` },
  },
];
---

<BaseLayout
  title="Contacto y horarios en Hortaleza (28033)"
  description="Calle Boyacá, 5, 1.º Dcha, 28033 Madrid. Teléfono 913 82 08 64. Horario de la Clínica Dental Hortaleza, mapa y formulario de contacto."
  extraSchema={extraSchema}
>
  <section class="border-b border-brand-900/10 bg-cream-100/60">
    <div class="container-page py-12 sm:py-14">
      <nav aria-label="Migas de pan" class="text-xs text-ink-500">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="no-underline hover:text-brand-800">Inicio</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-ink-700">Contacto</li>
        </ol>
      </nav>

      <h1 class="mt-5 font-display text-4xl leading-tight text-ink-900 sm:text-5xl">
        Contacto y horarios
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-700">
        Estamos en el barrio de Hortaleza, en Calle Boyacá, 5 (28033 Madrid). Llámanos, escríbenos
        o pide cita online.
      </p>
    </div>
  </section>

  <section class="py-12 sm:py-14">
    <div class="container-page grid gap-8 lg:grid-cols-[1fr_1.1fr] lg:items-start">
      <div class="space-y-4">
        <div class="rounded-3xl border border-brand-900/10 bg-white p-6 sm:p-7">
          <h2 class="font-display text-2xl text-ink-900">Datos de contacto</h2>

          <address class="mt-5 space-y-4 text-sm not-italic">
            <div class="flex items-start gap-3">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-700">
                <Icon name="map-pin" class="h-5 w-5" />
              </span>
              <div>
                <p class="font-semibold text-ink-900">{clinic.name}</p>
                <p class="text-ink-700">{addressLine}</p>
                <p class="text-ink-700">{clinic.address.district}, Madrid</p>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-700">
                <Icon name="phone" class="h-5 w-5" />
              </span>
              <div>
                <p class="font-semibold text-ink-900">Teléfono</p>
                <a href={telHref} class="text-brand-700 no-underline hover:underline">
                  {clinic.phoneDisplay}
                </a>
              </div>
            </div>

            {
              whatsappHref && (
                <div class="flex items-start gap-3">
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-700">
                    <Icon name="whatsapp" class="h-5 w-5" />
                  </span>
                  <div>
                    <p class="font-semibold text-ink-900">WhatsApp</p>
                    <a
                      href={whatsappHref}
                      class="text-brand-700 no-underline hover:underline"
                      target="_blank"
                      rel="noopener noreferrer"
                    >
                      Escribir por WhatsApp
                    </a>
                  </div>
                </div>
              )
            }

            {
              clinic.email && (
                <div class="flex items-start gap-3">
                  <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-700">
                    <Icon name="mail" class="h-5 w-5" />
                  </span>
                  <div>
                    <p class="font-semibold text-ink-900">Correo</p>
                    <a href={`mailto:${clinic.email}`} class="text-brand-700 no-underline hover:underline">
                      {clinic.email}
                    </a>
                  </div>
                </div>
              )
            }
          </address>

          <div class="mt-6 border-t border-brand-900/10 pt-5">
            <h3 class="text-sm font-semibold uppercase tracking-[0.14em] text-brand-800">Horario</h3>
            <dl class="mt-3 space-y-2 text-sm">
              {
                hours.map((line) => (
                  <div class="flex justify-between gap-6">
                    <dt class="text-ink-500">{line.days}</dt>
                    <dd class="font-medium text-ink-900">{line.hours}</dd>
                  </div>
                ))
              }
            </dl>
            <p class="mt-3 text-xs leading-relaxed text-ink-500">{clinic.hoursNote}</p>
          </div>

          <div class="mt-6 flex flex-wrap gap-3">
            <a href="/pedir-cita" class="btn-primary">
              <Icon name="calendar" class="h-4 w-4" />
              Pedir cita
            </a>
            <a href={telHref} class="btn-secondary">
              <Icon name="phone" class="h-4 w-4" />
              Llamar
            </a>
          </div>
        </div>

        <GoogleReviewsBadge />
      </div>

      <div class="space-y-6">
        <ContactForm />
        <LocationMap />
      </div>
    </div>
  </section>
</BaseLayout>
