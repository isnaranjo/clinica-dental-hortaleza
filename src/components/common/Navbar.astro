---
import { addressLine, clinic, instagramHref, ratingLabel, telHref, whatsappHref } from '../../data/clinic';
import Icon from './Icon.astro';

const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';

const links = [
  { href: '/tratamientos', label: 'Tratamientos' },
  { href: '/clinica', label: 'La clínica' },
  { href: '/equipo', label: 'Equipo' },
  { href: '/blog', label: 'Blog' },
  { href: '/contacto', label: 'Contacto' },
];

const isActive = (href: string) => pathname === href || pathname.startsWith(href + '/');
---

<div class="hidden bg-brand-900 text-brand-50 md:block">
  <div class="container-page flex items-center justify-between gap-6 py-2 text-xs">
    <p class="flex items-center gap-2">
      <Icon name="map-pin" class="h-4 w-4 text-brand-300" />
      <span>{addressLine}</span>
    </p>
    <div class="flex items-center gap-5">
      <span class="flex items-center gap-1.5">
        <Icon name="star" class="h-3.5 w-3.5 text-gold-400" />
        <span>{ratingLabel} en Google</span>
      </span>
      {
        instagramHref && (
          <a
            href={instagramHref}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram"
            class="text-brand-200 no-underline hover:text-white"
          >
            <Icon name="instagram" class="h-4 w-4" />
          </a>
        )
      }
      {
        whatsappHref && (
          <a
            href={whatsappHref}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="WhatsApp"
            class="text-brand-200 no-underline hover:text-white"
          >
            <Icon name="whatsapp" class="h-4 w-4" />
          </a>
        )
      }
      <a
        href={telHref}
        class="flex items-center gap-1.5 font-semibold text-white no-underline hover:text-brand-200"
      >
        <Icon name="phone" class="h-4 w-4" />
        <span class="hidden sm:inline">{clinic.phoneDisplay}</span>
      </a>
    </div>
  </div>
</div>

<header class="sticky top-0 z-40 border-b border-brand-900/10 bg-cream-50/95 backdrop-blur">
  <div class="container-page flex items-center justify-between gap-4 py-3">
    <a href="/" class="flex items-center gap-3 no-underline" aria-label={`${clinic.name} — inicio`}>
      <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-brand-700 text-white">
        <Icon name="tooth" class="h-6 w-6" />
      </span>
      <span class="leading-tight">
        <span class="block text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-brand-700">
          Clínica dental
        </span>
        <span class="block font-display text-lg font-semibold text-ink-900">Hortaleza</span>
      </span>
    </a>

    <nav aria-label="Navegación principal" class="hidden items-center gap-1 md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'rounded-full px-3.5 py-2 text-sm font-medium no-underline transition-colors',
              isActive(link.href)
                ? 'bg-brand-100 text-brand-800'
                : 'text-ink-700 hover:bg-brand-50 hover:text-brand-800',
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="hidden items-center gap-2 md:flex">
      <a href="/pedir-cita" class="btn-primary">
        <Icon name="calendar" class="h-4 w-4" />
        Pedir cita
      </a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="inline-flex items-center gap-2 rounded-full border border-brand-900/15 px-4 py-2 text-sm font-semibold text-brand-800 md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <Icon name="menu" class="h-5 w-5" />
      Menú
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-brand-900/10 bg-cream-50 md:hidden">
    <div class="container-page flex flex-col gap-1 py-4">
      <a href="/" class="rounded-xl px-3 py-2.5 text-sm font-medium text-ink-700 no-underline">Inicio</a>
      {
        links.map((link) => (
          <a
            href={link.href}
            aria-current={isActive(link.href) ? 'page' : undefined}
            class:list={[
              'rounded-xl px-3 py-2.5 text-sm font-medium no-underline',
              isActive(link.href) ? 'bg-brand-100 text-brand-800' : 'text-ink-700',
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <div class="mt-3 flex flex-col gap-2">
        <a href="/pedir-cita" class="btn-primary w-full">
          <Icon name="calendar" class="h-4 w-4" />
          Pedir cita
        </a>
        <a href={telHref} class="btn-secondary w-full">
          <Icon name="phone" class="h-4 w-4" />
          Llamar al {clinic.phoneDisplay}
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!isOpen));
    menu?.classList.toggle('hidden', isOpen);
  });

  if (menu) {
    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggle?.setAttribute('aria-expanded', 'false');
        menu.classList.add('hidden');
      });
    });
  }
</script>
