---
import BaseLayout from '../layouts/BaseLayout.astro';
import BookingWidget from '../components/booking/BookingWidget.astro';
import Icon from '../components/common/Icon.astro';
import { addressLine, clinic, siteUrl, telHref, whatsappHref } from '../data/clinic';
import { openingHoursLines } from '../lib/format';
import { breadcrumbSchema } from '../lib/schema-markup';

const hours = openingHoursLines();

const extraSchema = [
  breadcrumbSchema(siteUrl, [
    { name: 'Inicio', path: '/' },
    { name: 'Pedir cita', path: '/pedir-cita/' },
  ]),
];
---

<BaseLayout
  title="Pedir cita online en Hortaleza"
  description="Reserva cita en la Clínica Dental Hortaleza (Calle Boyacá 5, 28033): elige tratamiento, día y hora. Revisión 30 min, implantes 90 min. También por teléfono."
  extraSchema={extraSchema}
>
  <section class="border-b border-brand-900/10 bg-cream-100/60">
    <div class="container-page py-12 sm:py-14">
      <nav aria-label="Migas de pan" class="text-xs text-ink-500">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="no-underline hover:text-brand-800">Inicio</a></li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="text-ink-700">Pedir cita</li>
        </ol>
      </nav>

      <h1 class="mt-5 max-w-3xl font-display text-4xl leading-tight text-ink-900 sm:text-5xl">
        Pide tu cita
      </h1>
      <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-700">
        Elige el tratamiento y verás solo las horas en las que cabe la cita completa. La solicitud
        queda pendiente de confirmación por recepción.
      </p>
    </div>
  </section>

  <section class="py-10 sm:py-14">
    <div class="container-page grid gap-8 lg:grid-cols-[1.6fr_1fr] lg:items-start">
      <div>
        <BookingWidget />

        <noscript>
          <div class="mt-6 rounded-2xl border border-brand-900/15 bg-white p-5 text-sm text-ink-700">
            <p class="font-semibold text-ink-900">El formulario necesita JavaScript.</p>
            <p class="mt-2">
              Puedes pedir cita llamando al
              <a href={telHref} class="font-semibold text-brand-700">{clinic.phoneDisplay}</a>
              en horario de apertura (a partir de las 9:30).
            </p>
          </div>
        </noscript>
      </div>

      <aside class="space-y-4">
        <div class="rounded-3xl border border-brand-900/10 bg-white p-6">
          <h2 class="font-display text-xl text-ink-900">Prefieres llamar</h2>
          <p class="mt-2 text-sm leading-relaxed text-ink-500">
            Si tu caso es urgente o prefieres hablar con recepción, estamos al teléfono.
          </p>
          <a href={telHref} class="btn-primary mt-4 w-full">
            <Icon name="phone" class="h-4 w-4" />
            {clinic.phoneDisplay}
          </a>
          {
            whatsappHref && (
              <a href={whatsappHref} class="btn-secondary mt-2 w-full" target="_blank" rel="noopener noreferrer">
                <Icon name="whatsapp" class="h-4 w-4" />
                WhatsApp
              </a>
            )
          }
        </div>

        <div class="rounded-3xl border border-brand-900/10 bg-white p-6">
          <h2 class="font-display text-xl text-ink-900">Horario</h2>
          <dl class="mt-3 space-y-2 text-sm">
            {
              hours.map((line) => (
                <div class="flex justify-between gap-6 border-b border-brand-900/10 pb-2">
                  <dt class="text-ink-500">{line.days}</dt>
                  <dd class="font-medium text-ink-900">{line.hours}</dd>
                </div>
              ))
            }
          </dl>
          <p class="mt-3 text-xs leading-relaxed text-ink-500">{clinic.hoursNote}</p>
        </div>

        <div class="rounded-3xl border border-brand-900/10 bg-white p-6">
          <h2 class="font-display text-xl text-ink-900">Dónde estamos</h2>
          <p class="mt-2 flex items-start gap-2.5 text-sm text-ink-700">
            <Icon name="map-pin" class="mt-0.5 h-4 w-4 shrink-0 text-brand-600" />
            <span>{addressLine}<br />{clinic.address.district}, Madrid</span>
          </p>
          <a
            href="/contacto"
            class="mt-4 inline-flex items-center gap-2 text-sm font-semibold text-brand-700 no-underline hover:underline"
          >
            Ver mapa y contacto
            <Icon name="arrow-right" class="h-4 w-4" />
          </a>
        </div>

        <div class="rounded-3xl bg-brand-900 p-6 text-brand-50">
          <h2 class="font-display text-lg text-white">Antes de venir</h2>
          <ul class="mt-3 space-y-2 text-sm">
            <li class="flex gap-2">
              <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-brand-300" />
              Trae tu tarjeta sanitaria o el informe de otro profesional si lo tienes.
            </li>
            <li class="flex gap-2">
              <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-brand-300" />
              Si tomas anticoagulantes, avísanos al confirmar la cita.
            </li>
            <li class="flex gap-2">
              <Icon name="check" class="mt-0.5 h-4 w-4 shrink-0 text-brand-300" />
              Llega cinco minutos antes para completar la ficha.
            </li>
          </ul>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
