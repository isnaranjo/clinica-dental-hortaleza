{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "types": ["@cloudflare/workers-types"]
  },
  "include": [".astro/types.d.ts", "**/*", "src/env.d.ts"],
  "exclude": ["dist", "node_modules"]
}
