---
import { clinic, telHref } from '../../data/clinic';
import Icon from '../common/Icon.astro';
import Picture from '../common/Picture.astro';
import GoogleReviewsBadge from '../common/GoogleReviewsBadge.astro';
---

<section class="relative overflow-hidden border-b border-brand-900/10 bg-cream-50">
  <div
    aria-hidden="true"
    class="pointer-events-none absolute -right-40 -top-40 h-[28rem] w-[28rem] rounded-full bg-brand-100/70 blur-3xl"
  >
  </div>

  <div class="container-page relative grid gap-12 py-14 sm:py-20 lg:grid-cols-[1.05fr_1fr] lg:items-center">
    <div>
      <p class="eyebrow">Clínica dental en Hortaleza · 28033</p>

      <h1 class="mt-4 font-display text-4xl leading-[1.08] text-ink-900 sm:text-5xl">
        Odontología tranquila en el barrio de Hortaleza
      </h1>

      <p class="mt-5 max-w-xl text-lg leading-relaxed text-ink-700">
        Implantes, ortodoncia, endodoncias, prótesis y estética dental en Calle Boyacá, 5.
        Diagnóstico digital con radiografía panorámica y escáner intraoral, sin moldes
        tradicionales.
      </p>

      <p class="mt-3 text-sm font-medium text-brand-800">«{clinic.slogan}»</p>

      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a href="/pedir-cita" class="btn-primary px-7 py-3.5">
          <Icon name="calendar" class="h-4 w-4" />
          Pedir cita online
        </a>
        <a href={telHref} class="btn-secondary px-6 py-3.5">
          <Icon name="phone" class="h-4 w-4" />
          {clinic.phoneDisplay}
        </a>
      </div>

      <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-3">
        <GoogleReviewsBadge />
        <p class="flex items-center gap-2 text-sm text-ink-700">
          <Icon name="clock" class="h-4 w-4 text-brand-600" />
          Abrimos a las 9:30
        </p>
        <p class="flex items-center gap-2 text-sm text-ink-700">
          <Icon name="shield" class="h-4 w-4 text-brand-600" />
          Presupuesto por escrito
        </p>
      </div>
    </div>

    <div class="relative">
      <div class="overflow-hidden rounded-[2rem] border border-brand-900/10 bg-brand-100">
        <Picture
          src="/assets/img/clinica-recepcion.webp"
          alt="Recepción de la Clínica Dental Hortaleza, en Calle Boyacá 5"
          class="h-full w-full object-cover"
          priority
          sizes="(min-width: 1024px) 40vw, 100vw"
        />
      </div>

      <div
        class="absolute -bottom-6 left-5 hidden w-64 rounded-2xl border border-brand-900/10 bg-white p-4 shadow-[0_18px_40px_-24px_rgba(8,60,64,0.5)] sm:block"
      >
        <p class="flex items-center gap-2 text-sm font-semibold text-brand-800">
          <Icon name="scanner" class="h-4 w-4" />
          Sin moldes tradicionales
        </p>
        <p class="mt-1.5 text-xs leading-relaxed text-ink-500">
          Escáner intraoral y radiografía panorámica en la misma cita de diagnóstico.
        </p>
      </div>
    </div>
  </div>
</section>
