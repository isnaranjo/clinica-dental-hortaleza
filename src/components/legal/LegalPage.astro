---
interface Props {
  title: string;
  description: string;
  updated: string;
}

const { title, description, updated } = Astro.props;
---

<section class="border-b border-brand-900/10 bg-cream-100/60">
  <div class="container-page max-w-3xl py-12">
    <nav aria-label="Migas de pan" class="text-xs text-ink-500">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="no-underline hover:text-brand-800">Inicio</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-ink-700">{title}</li>
      </ol>
    </nav>
    <h1 class="mt-4 font-display text-3xl text-ink-900 sm:text-4xl">{title}</h1>
    <p class="mt-3 text-sm text-ink-500">Última actualización: {updated}</p>
  </div>
</section>

<section class="py-10">
  <div class="container-page max-w-3xl">
    <div class="prose-clinic">
      <slot />
    </div>
    <p class="mt-10 rounded-2xl bg-cream-100 p-5 text-xs leading-relaxed text-ink-500">
      {description}
    </p>
  </div>
</section>
